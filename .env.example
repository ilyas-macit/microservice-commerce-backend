# Environment Variables Template - Copy to .env and fill with your values
# IMPORTANT: Never commit the .env file to version control!

# ==========================================
# JWT Configuration (All Services)
# ==========================================
Jwt__Secret=your-super-secret-jwt-key-with-at-least-32-characters
Jwt__Issuer=MicroservicesIssuer
Jwt__Audience=MicroserviceClients
Jwt__ExpirationMinutes=60

# ==========================================
# AuthService Database
# ==========================================
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=AuthServiceDb;User Id=sa;Password=YourPassword123;

# ==========================================
# ProductService Database
# ==========================================
ProductService__ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=ProductServiceDb;User Id=sa;Password=YourPassword123;

# ==========================================
# LogService Database
# ==========================================
LogService__ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=LogServiceDb;User Id=sa;Password=YourPassword123;

# ==========================================
# API Gateway Configuration
# ==========================================
ApiGateway__AuthServiceUrl=http://localhost:5001
ApiGateway__ProductServiceUrl=http://localhost:5002
ApiGateway__LogServiceUrl=http://localhost:5003

# ==========================================
# Logging Configuration
# ==========================================
Serilog__MinimumLevel=Information
ASPNETCORE_ENVIRONMENT=Development

# ==========================================
# Optional: Redis Configuration (for caching)
# ==========================================
# Redis__ConnectionString=localhost:6379
# Redis__Password=

# ==========================================
# Optional: Email Configuration
# ==========================================
# Email__SmtpServer=smtp.gmail.com
# Email__SmtpPort=587
# Email__Username=your-email@gmail.com
# Email__Password=your-app-password
# Email__FromAddress=noreply@example.com
