# Copy this file to .env and set real values.
# Never commit .env to source control.

# Common
ASPNETCORE_ENVIRONMENT=Development

# SQL Server
SQL_SA_PASSWORD=YourPass123!
SQLSERVER_PORT=1433
AUTH_DB_NAME=AuthDb
PRODUCT_DB_NAME=ProductDb
LOG_DB_NAME=LogDb

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_PORT=6379

# Seq
SEQ_INGEST_PORT=5341
SEQ_UI_PORT=8080

# JWT (shared)
JWT_KEY=supersecretkey_minimum32characters!!
JWT_ISSUER=AuthService
JWT_AUDIENCE=MicroserviceApp
JWT_EXPIRY_MINUTES=60

# Service host ports
AUTH_SERVICE_PORT=5001
PRODUCT_SERVICE_PORT=5002
LOG_SERVICE_PORT=5003
API_GATEWAY_PORT=5000
