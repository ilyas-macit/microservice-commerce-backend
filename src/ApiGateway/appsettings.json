{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Key": "supersecretkey_minimum32characters!!",
    "Issuer": "AuthService",
    "Audience": "",
    "ExpirationMinutes": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "AuthCluster",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "product-read-route": {
        "ClusterId": "ProductCluster",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "product-write-route": {
        "ClusterId": "ProductCluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [ "PUT" ]
        }
      },
      "product-add-route": {
        "ClusterId": "ProductCluster",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/products",
          "Methods": [ "POST" ]
        }
      },
      "log-route": {
        "ClusterId": "LogCluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/logs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "AuthCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "ProductCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "LogCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
