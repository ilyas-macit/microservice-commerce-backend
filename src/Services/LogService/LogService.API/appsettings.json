{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LogServiceDb;User Id=sa;Password=;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/logservice-log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Key": "supersecretkey_minimum32characters!!",
    "Issuer": "AuthService",
    "Audience": "",
    "ExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
